{
  "name": "dsh-deepseek-peak-clock",
  "version": "1.0.0",
  "type": "module",
  "description": "DeepSeek peak/off-peak price clock for the DeepSeek Harness composer HUD.",
  "license": "MIT",
  "author": "esketids",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "pricing",
    "hud"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/esketids/dsh-deepseek-peak-clock.git"
  },
  "homepage": "https://github.com/esketids/dsh-deepseek-peak-clock#readme",
  "bugs": {
    "url": "https://github.com/esketids/dsh-deepseek-peak-clock/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
